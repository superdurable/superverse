{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additionalListeners": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hostname"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "hostname": {"type": "string", "pattern": "^\\*\\.[a-z0-9.-]+$"}
            }
          }
        }
      }
    },
    "sandboxProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codingProfile"
      ],
      "properties": {
        "codingProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "workspace"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "digest"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[^@]*$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "size"
              ],
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            }
          }
        }
      }
    },
    "hostedProjects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dexImage",
        "applicationRepository",
        "certificateArn"
      ],
      "properties": {
        "dexImage": {
          "type": "string"
        },
        "applicationRepository": {
          "type": "string"
        },
        "certificateArn": {
          "type": "string"
        }
      }
    },
    "studio": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        }
      }
    },
    "loginHost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "certificateArn": {"type": "string"}
      }
    },
    "dex": {
      "type": "object",
      "properties": {
        "debugIngress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "webAuthSecretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "webAuthSecretName"
            ],
            "properties": {
              "webAuthSecretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
