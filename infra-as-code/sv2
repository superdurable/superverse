#!/usr/bin/env python3
"""One operator entry for V2 Kind, Native, their shared local data, Terraform, release evidence and HCP."""
import argparse
import importlib
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "scripts"))
from commands import CommandInterrupted

LANES = {"kind": "kind.cli", "native": "native.cli", "local": "local_prune", "terraform": "hcp.runs", "release": "release.cli", "hcp": "hcp.workspaces"}

parser = argparse.ArgumentParser(description=__doc__, epilog="Use <lane> --help for exact commands. All cluster/state addresses remain unchanged.")
parser.add_argument("lane", choices=LANES)
lane = parser.parse_args(sys.argv[1:2]).lane
sys.argv = [sys.argv[0] + " " + lane, *sys.argv[2:]]
# The only error boundary: operator-facing failures print their message; anything else may
# quote private configuration, captured command output or provider responses, so it never does.
try:
    importlib.import_module(LANES[lane]).main()
except (RuntimeError, CommandInterrupted) as error:
    print(error, file=sys.stderr)
    raise SystemExit(1) from None
except ModuleNotFoundError as error:
    print(f"Python module {error.name} is missing; install infra-as-code/validation-requirements.txt into the environment running sv2", file=sys.stderr)
    raise SystemExit(1) from None
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError, KeyboardInterrupt):
    print(f"sv2 {lane} failed on a private input, command or provider response; inspect retained evidence privately", file=sys.stderr)
    raise SystemExit(1) from None
