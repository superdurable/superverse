# Build from the repository root with --platform linux/arm64. All upstream
# image descriptors and downloaded archives are immutable reviewed inputs.
FROM docker.io/moby/buildkit:v0.25.1@sha256:8f251fda6057e9dffc54f7874b249920f15f1813e9b1406a0cebeca5e4ab1ad9 AS buildkit
FROM docker.io/library/python:3.13.15-slim-bookworm@sha256:ad4c34ff79289506e235b40dce75d629e25f226b597a2455804220f037e07531

RUN test "$(dpkg --print-architecture)" = arm64 \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260915T000000Z bookworm main' > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends iptables iproute2 unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ADD --checksum=sha256:667395fbffab52901b80181dfbb39ea76da2fbd7642c4fbddd24e42146b07b48 https://download.docker.com/linux/static/stable/aarch64/docker-29.8.1.tgz /tmp/docker.tgz
ADD --checksum=sha256:12c347c73cb150e96cb6450974b1a2998760a882740cd04a39426634a957f27f https://awscli.amazonaws.com/awscli-exe-linux-aarch64-2.31.9.zip /tmp/awscli.zip
RUN tar -xzf /tmp/docker.tgz --strip-components=1 -C /usr/local/bin \
    && unzip -q /tmp/awscli.zip -d /tmp/awscli \
    && /tmp/awscli/aws/install --install-dir /usr/local/aws-cli --bin-dir /usr/local/bin \
    && rm -rf /tmp/docker.tgz /tmp/awscli.zip /tmp/awscli
COPY --from=buildkit /usr/bin/buildkitd /usr/bin/buildctl /usr/bin/buildkit-runc /usr/local/bin/
COPY internal/delivery/releases/build/hosted/start-docker.py internal/delivery/releases/build/hosted/daemon.json /usr/local/lib/sv2/
RUN docker --version \
    && aws --version \
    && buildkitd --version \
    && buildctl --version \
    && buildkit-runc --version \
    && iptables --version \
    && ip6tables --version

LABEL io.superdurable.hosted-build-host="v2" \
      io.superdurable.buildkit="0.25.1" \
      io.superdurable.docker="29.8.1" \
      io.superdurable.aws-cli="2.31.9"
ENV DOCKER_HOST=unix:///var/run/docker.sock \
    AWS_PAGER="" \
    PYTHONDONTWRITEBYTECODE=1
# Keep overlay2 data off the host container's writable overlay. Docker creates
# an execution-owned anonymous volume; the outer runtime must dispose it.
VOLUME ["/var/lib/sv2-docker"]
WORKDIR /workspace
CMD ["/bin/bash"]
