{
  "hosts": ["unix:///var/run/docker.sock"],
  "data-root": "/var/lib/sv2-docker",
  "exec-root": "/var/run/sv2-docker",
  "pidfile": "/var/run/sv2-dockerd.pid",
  "storage-driver": "overlay2",
  "features": {"containerd-snapshotter": false},
  "firewall-backend": "iptables",
  "iptables": true,
  "ip6tables": true,
  "ipv6": false,
  "userland-proxy": true,
  "log-driver": "none"
}
