# Build from the V2 repository root, review and publish only after acceptance.
# Tool images are supplied to HostedBuildConfig by immutable ECR digest.
FROM public.ecr.aws/docker/library/golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY gen ./gen
# app-manifest imports appmanifest and the shared packages it builds on.
COPY internal ./internal
COPY cmd/tools/app-manifest ./cmd/tools/app-manifest
RUN --network=none go build -trimpath -o /out/app-manifest ./cmd/tools/app-manifest
ARG TARGETARCH
ARG DEXCLI_VERSION
ARG HOSTED_BUILD_TOOLS_VERSION
RUN set -eu; case "$TARGETARCH" in \
      amd64) digest=0259406a6187ae58136e80050689af9ccc8cba30dea682f817e78ad4656faefd ;; \
      arm64) digest=62d3a93bf61a14a092d5519ff498580b6c092b6f434bddc514842fd23e5f0613 ;; \
      *) exit 64 ;; \
    esac; \
    test -n "$DEXCLI_VERSION"; test -n "$HOSTED_BUILD_TOOLS_VERSION"; \
    curl --fail --silent --show-error --location "https://github.com/superdurable/dex/releases/download/cli-v${DEXCLI_VERSION}/dexcli_v${DEXCLI_VERSION}_linux_${TARGETARCH}.tar.gz" -o /tmp/dexcli.tar.gz; \
    printf '%s  %s\n' "$digest" /tmp/dexcli.tar.gz | sha256sum --check; \
    mkdir /tmp/dexcli; tar -xzf /tmp/dexcli.tar.gz -C /tmp/dexcli; \
    install -m 0755 /tmp/dexcli/dexcli /out/dexcli

FROM public.ecr.aws/docker/library/golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd
COPY --from=build /out/app-manifest /out/dexcli /usr/local/bin/
ARG DEXCLI_VERSION
ARG HOSTED_BUILD_TOOLS_VERSION
RUN test -n "$DEXCLI_VERSION" && test -n "$HOSTED_BUILD_TOOLS_VERSION"
LABEL io.superdurable.hosted-build-tools="$HOSTED_BUILD_TOOLS_VERSION" io.superdurable.dexcli="$DEXCLI_VERSION"
ENV GOTOOLCHAIN=local CGO_ENABLED=0
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["dexcli"]
