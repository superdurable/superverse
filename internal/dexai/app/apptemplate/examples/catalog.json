  {
    "id": "github-releases-newsletter",
    "title": "GitHub releases newsletter",
    "card": {
      "title": "GitHub Releases Newsletter",
      "summary": "Visitors subscribe once; an authorized Slack message starts a release newsletter and each subscriber receives an individual Gmail delivery.",
      "features": [
        {
          "id": "R1",
          "text": "The public page accepts valid email subscriptions, retains each normalized address once and gives clear feedback."
        },
        {
          "id": "R2",
          "text": "Only a selected administrator posting the exact top-level Slack message publish newsletter in the selected channel starts a campaign; duplicate delivery of that message starts none."
        },
        {
          "id": "R3",
          "text": "The campaign reads every release page from superdurable/dex and dex-connectors-library, excludes drafts, filters by the previous seven days and keeps original links."
        },
        {
          "id": "R4",
          "text": "OpenAI writes a factual newsletter from release notes, or the report clearly says there are no releases; source or model failure never sends an incomplete report."
        },
        {
          "id": "R5",
          "text": "The campaign freezes subscribers at trigger time; Gmail sends the same report to each individually and records sent, failed or uncertain delivery without automatically retrying an uncertain send."
        }
      ],
      "connections": [
        {
          "need": "Receive the administrator publish command",
          "connector": "slack",
          "operations": [
            "channelThreadCreated"
          ],
          "status": "existing",
          "user_setup": "Authorize Slack, select the channel and administrator members in Studio."
        },
        {
          "need": "Read release pages",
          "connector": "GitHub v0.23.0",
          "operations": [
            "listReleases"
          ],
          "status": "existing",
          "user_setup": "Authorize GitHub access to the two repositories."
        },
        {
          "need": "Summarize releases",
          "connector": "LLM v0.22.1 (OpenAI provider)",
          "operations": [
            "generateText"
          ],
          "status": "existing",
          "user_setup": "Configure the OpenAI key and model."
        },
        {
          "need": "Send each newsletter email",
          "connector": "Gmail v0.23.0",
          "operations": [
            "sendMessage"
          ],
          "status": "existing",
          "user_setup": "Authorize the Gmail sender account."
        }
      ],
      "user_setup": [
        "Invite the Slack app to the publishing channel and configure four TeamSpace connections."
      ],
      "acceptance": [
        "A subscribed test address receives a Gmail message after the authorized Slack command, and the campaign reports a successful delivery."
      ],
      "design": {
        "summary": "Visitors subscribe once; an administrator's Slack message starts a campaign that reads two repositories' releases, writes one report with OpenAI and sends it to each frozen subscriber by Gmail.",
        "flows": [
          {
            "flow_type": "SubscriptionRegistryFlow",
            "purpose": "Keeps every subscriber's normalized email address once.",
            "start_step": "AwaitSubscription",
            "steps": [
              {
                "step_type": "AwaitSubscription",
                "group": "Subscriptions",
                "explanation": "Wait for a visitor to submit an email address.",
                "next": [
                  {
                    "to": "RecordSubscription",
                    "when": "a visitor submitted an address"
                  }
                ],
                "waits_for": {
                  "kind": "channel",
                  "name": "SubscriptionRequests"
                }
              },
              {
                "step_type": "RecordSubscription",
                "group": "Subscriptions",
                "explanation": "Save a new subscriber once and preserve an existing subscription.",
                "next": [
                  {
                    "to": "AwaitSubscription"
                  }
                ]
              }
            ],
            "channels": [
              {
                "name": "SubscriptionRequests",
                "payload": "a visitor's email address"
              }
            ],
            "actions": [],
            "attributes": [
              {
                "name": "RegistryStatus",
                "value": "registry status"
              },
              {
                "name": "SubscriberCount",
                "value": "subscriber count"
              },
              {
                "name": "Subscribers",
                "value": "subscribers"
              }
            ],
            "starts": []
          },
          {
            "flow_type": "NewsletterCampaignFlow",
            "purpose": "Collects the last seven days of releases of two repositories, writes one report and sends it to each frozen subscriber by Gmail.",
            "start_step": "PrepareNewsletterRun",
            "steps": [
              {
                "step_type": "PrepareNewsletterRun",
                "group": "Start",
                "explanation": "Freeze the trigger identity and the seven-day publication window.",
                "next": [
                  {
                    "to": "LoadSubscribers"
                  }
                ]
              },
              {
                "step_type": "LoadSubscribers",
                "group": "Delivery",
                "explanation": "Freeze the subscribers for this campaign before sending any email.",
                "next": [
                  {
                    "to": "ListDexReleases"
                  }
                ]
              },
              {
                "step_type": "ListDexReleases",
                "group": "Releases",
                "explanation": "Read one page of dex releases.",
                "next": [
                  {
                    "to": "RecordDexReleasePage",
                    "when": "listed"
                  },
                  {
                    "to": "RecordReleaseFailure",
                    "when": "any other branch"
                  }
                ]
              },
              {
                "step_type": "RecordDexReleasePage",
                "group": "Releases",
                "explanation": "Keep the dex release page and choose the next page or repository.",
                "next": [
                  {
                    "to": "RecordReleaseFailure",
                    "when": "the page was not listed or its next page is invalid"
                  },
                  {
                    "to": "ListDexReleases",
                    "when": "dex has another page"
                  },
                  {
                    "to": "ListConnectorReleases",
                    "when": "dex is read completely"
                  }
                ]
              },
              {
                "step_type": "RecordReleaseFailure",
                "group": "Releases",
                "explanation": "Stop when a repository could not be read completely.",
                "next": [
                  {
                    "to": "complete"
                  }
                ]
              },
              {
                "step_type": "ListConnectorReleases",
                "group": "Releases",
                "explanation": "Read one page of dex-connectors-library releases.",
                "next": [
                  {
                    "to": "RecordConnectorReleasePage",
                    "when": "listed"
                  },
                  {
                    "to": "RecordReleaseFailure",
                    "when": "any other branch"
                  }
                ]
              },
              {
                "step_type": "RecordConnectorReleasePage",
                "group": "Releases",
                "explanation": "Keep the connector-library release page and choose the next page or report.",
                "next": [
                  {
                    "to": "RecordReleaseFailure",
                    "when": "the page was not listed or its next page is invalid"
                  },
                  {
                    "to": "ListConnectorReleases",
                    "when": "the connectors library has another page"
                  },
                  {
                    "to": "PrepareNewsletterReport",
                    "when": "both repositories are read completely"
                  }
                ]
              },
              {
                "step_type": "PrepareNewsletterReport",
                "group": "Report input",
                "explanation": "Build a bounded report input from every collected release.",
                "next": [
                  {
                    "to": "SaveNoReleaseReport",
                    "when": "no release in the window"
                  },
                  {
                    "to": "RecordReleaseFailure",
                    "when": "the report input is too large"
                  },
                  {
                    "to": "GenerateNewsletterReport",
                    "when": "releases to summarize"
                  }
                ]
              },
              {
                "step_type": "SaveNoReleaseReport",
                "group": "No releases",
                "explanation": "State clearly that neither repository published a release.",
                "next": [
                  {
                    "to": "SelectNextRecipient"
                  }
                ]
              },
              {
                "step_type": "GenerateNewsletterReport",
                "group": "Report",
                "explanation": "Summarize release facts with OpenAI.",
                "next": [
                  {
                    "to": "RecordGenerationFailure",
                    "when": "blocked, defect, invalidResponse, providerRejected or truncated"
                  },
                  {
                    "to": "RecordGenerationUncertainty",
                    "when": "the model response was lost",
                    "is_failure_route": true
                  },
                  {
                    "to": "SaveNewsletterReport",
                    "when": "generated"
                  }
                ]
              },
              {
                "step_type": "SelectNextRecipient",
                "group": "Delivery",
                "explanation": "Choose the next subscriber without a recorded delivery.",
                "next": [
                  {
                    "to": "SendNewsletterEmail",
                    "when": "a subscriber has no recorded delivery"
                  },
                  {
                    "to": "FinishNewsletter",
                    "when": "every subscriber has a recorded delivery"
                  }
                ]
              },
              {
                "step_type": "RecordGenerationFailure",
                "group": "Report failure",
                "explanation": "Stop when the model did not return a complete report.",
                "next": [
                  {
                    "to": "complete"
                  }
                ]
              },
              {
                "step_type": "RecordGenerationUncertainty",
                "group": "Report",
                "explanation": "Keep a lost paid model response unknown rather than sending another request.",
                "next": [
                  {
                    "to": "complete"
                  }
                ]
              },
              {
                "step_type": "SaveNewsletterReport",
                "group": "Report",
                "explanation": "Keep only a complete, usable model report.",
                "next": [
                  {
                    "to": "RecordGenerationFailure",
                    "when": "the model's text is not a usable report"
                  },
                  {
                    "to": "SelectNextRecipient",
                    "when": "the report is saved"
                  }
                ]
              },
              {
                "step_type": "SendNewsletterEmail",
                "group": "Delivery",
                "explanation": "Send one subscriber their own email.",
                "next": [
                  {
                    "to": "RecordDelivery",
                    "when": "defect, providerRejected, sent or uncertain"
                  },
                  {
                    "to": "RecordDeliveryUncertainty",
                    "when": "the Gmail response was lost",
                    "is_failure_route": true
                  }
                ]
              },
              {
                "step_type": "FinishNewsletter",
                "group": "Finish",
                "explanation": "Complete the campaign with durable delivery counts.",
                "next": [
                  {
                    "to": "complete"
                  }
                ]
              },
              {
                "step_type": "RecordDelivery",
                "group": "Delivery",
                "explanation": "Record Gmail's conclusive or uncertain result for one subscriber.",
                "next": [
                  {
                    "to": "SelectNextRecipient"
                  }
                ]
              },
              {
                "step_type": "RecordDeliveryUncertainty",
                "group": "Delivery",
                "explanation": "Record a lost Gmail response without resending the email.",
                "next": [
                  {
                    "to": "SelectNextRecipient"
                  }
                ]
              }
            ],
