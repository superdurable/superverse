  {
    "id": "slack-thread-approval",
    "title": "Slack thread approval",
    "card": {
      "title": "Slack thread approval",
      "summary": "A process that follows threads in one Slack channel: a new message starts it, and a reply in its thread finishes it with a confirmation posted in the thread.",
      "features": [
        {
          "id": "R1",
          "text": "A new top-level message in the configured Slack channel starts one approval for its thread; a redelivered message starts no second one."
        },
        {
          "id": "R2",
          "text": "The first matching reply in that thread is accepted and moves the approval on; a later reply changes nothing."
        },
        {
          "id": "R3",
          "text": "After the reply, the application posts Processing complete. into the same thread and completes the approval."
        }
      ],
      "connections": [
        {
          "need": "Receive new channel messages and thread replies, and reply in the thread",
          "connector": "slack",
          "operations": [
            "postThreadReply"
          ],
