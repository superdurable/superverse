[
  {
    "id": "text-summary",
    "title": "Text summary",
    "card": {
      "title": "Text summary",
      "summary": "A page where a person submits a text and gets a short factual summary from the configured AI model, with the model and token usage shown.",
      "features": [
        {
          "id": "R1",
          "text": "A blank, too long or invalid text is refused before any model request, and the refused submission starts no summary."
        },
        {
          "id": "R2",
          "text": "A repeated submission with the same request ID starts one summary."
        },
        {
          "id": "R3",
          "text": "The configured model writes a short factual summary, which the page shows with the model and token usage; a summary cut at the output limit is shown as truncated."
        },
        {
          "id": "R4",
          "text": "A blocked, rejected, invalid or failed model answer shows its status and a notice and no summary."
        },
        {
          "id": "R5",
          "text": "A lost model response is recorded as unknown without sending the paid request again."
        }
      ],
      "connections": [
        {
          "need": "Summarize the text",
          "connector": "llm",
          "operations": [
            "generateText"
          ],
          "status": "existing",
          "user_setup": "Configure the summary-model connection with a provider key and a model in Studio Configuration."
        }
      ],
      "user_setup": [],
      "acceptance": [
        "A submitted text shows its summary, the model and the token usage on the page, and its run completes in Studio."
      ],
      "design": {
        "summary": "One text is validated, summarized by the configured model and saved with the model and its token usage; every other answer is recorded with a notice.",
        "flows": [
          {
            "flow_type": "TextSummaryFlow",
            "purpose": "Summarizes one text with one paid model request and keeps the result.",
            "start_step": "PrepareSummary",
            "steps": [
              {
                "step_type": "PrepareSummary",
                "group": "Text intake",
                "explanation": "Validate and keep the text before any paid model request.",
                "next": [
                  {
                    "to": "GenerateSummary",
                    "when": "the text is valid"
                  },
                  {
                    "to": "complete",
                    "when": "the text is empty, too long or not UTF-8"
                  }
                ],
                "features": [
                  "R1",
                  "R2"
                ]
              },
              {
                "step_type": "GenerateSummary",
                "group": "Summary",
                "explanation": "Ask the configured model for a short factual summary.",
                "next": [
                  {
                    "to": "SaveSummaryResult",
                    "when": "generated"
                  },
                  {
                    "to": "SaveSummaryResult",
                    "when": "truncated"
                  },
                  {
                    "to": "RecordSummaryFailure",
                    "when": "blocked, rejected, invalid or a defect"
                  },
                  {
                    "to": "RecordSummaryUncertainty",
                    "when": "the model response was lost",
                    "is_failure_route": true
                  }
                ],
                "features": [
                  "R3",
                  "R4"
                ]
              },
              {
                "step_type": "SaveSummaryResult",
                "group": "Result",
                "explanation": "Save the summary, the model and the token usage.",
                "next": [
                  {
                    "to": "complete"
                  }
                ],
                "features": [
                  "R3"
                ]
              },
              {
                "step_type": "RecordSummaryFailure",
                "group": "Result",
                "explanation": "Record why the model returned no usable summary.",
                "next": [
                  {
                    "to": "complete"
                  }
                ],
                "features": [
                  "R4"
                ]
              },
              {
                "step_type": "RecordSummaryUncertainty",
                "group": "Result",
                "explanation": "Record a lost model response without sending the paid request again.",
                "next": [
                  {
                    "to": "complete"
                  }
                ],
                "features": [
                  "R5"
                ]
              }
            ],
            "channels": [],
            "actions": [],
            "attributes": [
              {
                "name": "SummaryStatus",
                "value": "pending, generating, completed, truncated, blocked, provider_rejected, invalid_response, defect, invalid_input or unknown"
              },
              {
                "name": "SummaryText",
                "value": "the saved summary"
              }
            ]
          }
        ]
      }
    },
    "trace": [
      {
        "id": "R1",
        "text": "A blank, too long or invalid text is refused before any model request, and the refused submission starts no summary.",
        "evidence": [
          "internal/api/handler.go",
