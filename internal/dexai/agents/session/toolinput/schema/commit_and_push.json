{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "verification"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "verification": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "remaining_risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 60,
      "description": "Every requirement of the current version with the code that implements it and the API tests that prove it. Pass none for a change that has no recorded requirements.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4,
            "description": "A feature ID of the current requirements, such as R1."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "description": "The files or symbols that implement it.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "tests": {
            "type": "array",
            "maxItems": 10,
            "description": "The API tests that prove it, such as TestOrderApproval or TestOrderApproval/stale_decision; each must pass in the commit's test run.",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 256,
              "pattern": "^Test[A-Za-z0-9_]*(/[^\\s]+)?$"
            }
          },
          "untested_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Why no API test can prove it, such as a connector without mocks; required when tests is empty."
          }
        }
      }
    },
    "requirements_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "The current version of the requirements, which the trace refers to; required with requirements."
    },
    "blocked": {
      "type": "boolean",
      "default": false
    }
  }
}
