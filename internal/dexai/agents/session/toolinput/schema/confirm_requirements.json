{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "features", "connections", "user_setup", "acceptance"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "The application or change in a few business words."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "What will be built and for whom, in business language."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Every behavior the user will get, each one a single behavior that a test can prove, with IDs in increasing order. A first card and a card that replaces the requirements number them R1, R2, ...; a revised card keeps the ID of every recorded feature it keeps or changes and numbers a new feature above every number the requirements have used, so a removed feature's number is never reused and the IDs may have gaps.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4,
            "description": "R followed by the feature's number, such as R1; it stays the same in every later version."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 10,
      "description": "The external systems the application talks to; empty when it needs none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "connector", "operations", "status", "user_setup"],
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "What the application needs from the system."
          },
          "connector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The released connector that provides it."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "status": {
            "type": "string",
            "enum": ["existing", "new"],
            "description": "existing when the Project already has this connection, new when the user must create it."
          },
          "user_setup": {
            "type": "string",
            "maxLength": 600,
            "description": "What the user must do for this connection, such as granting access in Studio; empty when nothing."
          }
        }
      }
    },
    "user_setup": {
      "type": "array",
      "maxItems": 20,
      "description": "What the user must prepare outside the connections; empty when nothing.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "acceptance": {
      "type": "array",
      "maxItems": 20,
      "description": "How the user can check that the work is done.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "replaces_requirements": {
      "type": "boolean",
      "description": "True only for a completely different request after a recorded version: the card replaces the recorded requirements instead of revising them, and its features are numbered from R1 again.",
      "default": false
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "flows"],
      "description": "The Flows the card adds or changes, before any code: required on a card for a new application or a large change that adds, removes or changes a Flow's Steps, waits, transitions, Channels, Actions or the Flows it starts; absent otherwise. Studio draws it for the user until the build is complete. Names are the Go type names you will implement.",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "The design in business language: which processes run, who acts where, what waits for whom."
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Each Flow the card adds or changes, listed in full.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["flow_type", "purpose", "start_step", "steps"],
            "properties": {
              "flow_type": {
                "type": "string",
                "minLength": 5,
                "maxLength": 80,
                "pattern": "^[A-Z][A-Za-z0-9]*Flow$",
                "description": "The Go type name to implement, ending in Flow."
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "One sentence."
              },
              "start_step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "The Step the Flow starts with."
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["step_type", "group", "explanation", "next"],
                  "properties": {
                    "step_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Z][A-Za-z0-9]*$",
                      "description": "The Go type name of the Step, unique in the Flow."
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "The stage label. A group of two or more main-story Steps is one run, where ordinary transitions inside it join all of its Steps, or one choice, where one Step outside it leads into every part."
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "What the Step does, in one business sentence."
                    },
                    "waits_for": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind"],
                      "description": "What the Step waits for before it runs; absent when it waits for nothing.",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["none", "action", "channel", "timer"],
                          "description": "action: a person answers through an Action of this Flow, whose rpc is name; channel: another sender publishes to a Channel of this Flow, named in name; timer: name says the business time."
                        },
                        "name": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        }
                      }
                    },
                    "next": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "description": "Where the Step goes.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["to"],
                        "properties": {
                          "to": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^([A-Z][A-Za-z0-9]*|complete|fail)$",
                            "description": "A Step of this Flow, or complete or fail."
                          },
                          "when": {
                            "type": "string",
                            "minLength": 0,
                            "maxLength": 80,
                            "description": "The condition in words; empty for the only way out."
                          },
                          "is_failure_route": {
                            "type": "boolean",
                            "default": false,
                            "description": "True only when the Step's failure leads there, for breakage such as retries that ran out or a lost response; never for a business rejection or a failed check, which stay ordinary transitions."
                          }
                        }
                      }
                    },
                    "features": {
                      "type": "array",
                      "maxItems": 20,
                      "description": "The card's features this Step serves.",
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 4
                      }
                    }
                  }
                }
              },
              "channels": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "payload"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Z][A-Za-z0-9]*$",
                      "description": "The Channel's name."
                    },
                    "payload": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "What it carries, in words."
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "rpc", "permission"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60,
                      "description": "What Studio shows, such as Approve summary."
                    },
                    "rpc": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Z][A-Za-z0-9]*$",
                      "description": "The RPC's Go name."
                    },
                    "publishes": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "The Channel of this Flow that the Action publishes to; empty when none."
                    },
                    "permission": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "description": "The Action permission, such as summary.approve."
                    }
                  }
                }
              },
              "attributes": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Z][A-Za-z0-9]*$",
                      "description": "The Attribute's name."
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "What it holds, in words."
                    },
                    "is_map": {
                      "type": "boolean",
                      "default": false,
                      "description": "True for an AttributeMap."
                    },
                    "key": {
                      "type": "string",
                      "maxLength": 120,
                      "description": "The instance key format; required for an AttributeMap."
                    }
                  }
                }
              },
              "starts": {
                "type": "array",
                "maxItems": 6,
                "description": "Flows this Flow starts.",
                "items": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 80,
                  "pattern": "^[A-Z][A-Za-z0-9]*Flow$"
                }
              }
            }
          }
        },
        "removed_flows": {
          "type": "array",
          "maxItems": 6,
          "description": "Flows of the current source that the change deletes.",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 80,
            "pattern": "^[A-Z][A-Za-z0-9]*Flow$"
          }
        }
      }
    }
  }
}
