{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "mock": "SUPERVERSE_STUDIO_MOCK=true next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css}\"",
    "test": "npm run test:e2e",
    "generate:check": "node scripts/generate-protobuf-types.mjs --check",
    "check:pins": "node scripts/check-consumed-pins.mjs",
    "check:unused": "SUPERVERSE_E2E_BASE_URL=https://knip.invalid knip",
    "check:modules": "node scripts/check-modules.mjs",
    "check:readmes": "node scripts/check-readmes.mjs",
    "generate:readmes": "node scripts/check-readmes.mjs --write",
    "check:styles": "node scripts/check-styles.mjs",
    "check:source": "npm run generate:check && npm run check:pins && npm run format:check && npm run typecheck && npm run check:unused && npm run check:modules && npm run check:readmes",
    "check:build": "npm run build && npm run check:styles",
    "check": "npm run check:source && npm run lint && npm run check:build",
    "typecheck": "next typegen && tsc --noEmit && tsc -p scripts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "generate:protobuf": "node scripts/generate-protobuf-types.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.0",
    "@xyflow/react": "^12.11.6",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "dagre": "^0.8.5",
    "elkjs": "0.11.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "3.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.39.0",
    "playwright-core": "1.55.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
